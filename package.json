{
  "name": "@obsidian/market-data",
  "version": "0.1.0",
  "description": "Shared crypto market-data client for Obsidian Division",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "obsidian-market": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "node dist/cli.js",
    "watch:start": "scripts/watchd.sh start",
    "watch:stop": "scripts/watchd.sh stop",
    "watch:status": "scripts/watchd.sh status",
    "watch:selftest": "node dist/cli.js watch --once"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
